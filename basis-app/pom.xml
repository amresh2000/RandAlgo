<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.penguinsecure.basis</groupId>
    <artifactId>basis-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>basis-app</artifactId>
  <name>Basis Application</name>
  <dependencies>
    <dependency>
      <groupId>com.penguinsecure.basis</groupId>
      <artifactId>basis-protocol</artifactId>
    </dependency>
    <dependency>
      <groupId>com.penguinsecure.basis</groupId>
      <artifactId>basis-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.penguinsecure.basis</groupId>
      <artifactId>basis-strategy-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.penguinsecure.basis</groupId>
      <artifactId>basis-strategy-basis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.penguinsecure.basis</groupId>
      <artifactId>basis-venue-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.penguinsecure.basis</groupId>
      <artifactId>basis-venue-bybit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.penguinsecure.basis</groupId>
      <artifactId>basis-venue-deribit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.penguinsecure.basis</groupId>
      <artifactId>basis-journal</artifactId>
    </dependency>
    <dependency>
      <groupId>com.penguinsecure.basis</groupId>
      <artifactId>basis-sim</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.agrona</groupId>
      <artifactId>agrona</artifactId>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-handler</artifactId>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <finalName>basis-market-data</finalName>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.penguinsecure.basis.app.marketdata.PublicMarketDataRunner</mainClass>
                  <manifestEntries>
                    <Add-Exports>java.base/jdk.internal.misc</Add-Exports>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
